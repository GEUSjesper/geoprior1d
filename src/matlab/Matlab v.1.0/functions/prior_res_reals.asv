function n = prior_res_reals(info, m, o, layer_index, z_vec)

% Initialize n vector
n = m;
if o ~= z_vec(1)
    n_unsat = n;
end


% Input resistivities for each layer
for i = 1:max(layer_index)
    for j = 1:max(info.Classes.codes)
        method1 = info.Resistivity.format1(j);
        
        if method1 == 1
            % Due to the definition of log-gaussian resistivity uncertainty
            res_unc = log10(info.Resistivity.res2{j}) / 3;
            n(m == j & layer_index == i) =  10.^(log10(info.Resistivity.res1{j}) + res_unc * randn);

        elseif method1 == 2
            n(m == j & layer_index == i) =  (info.Resistivity.res2{j} - info.Resistivity.res1{j}) * rand + info.Resistivity.res1{j};

        elseif method1 == 3
            resistivities = info.Resistivity.res1{j};
            probs = info.Resistivity.res2{j};
            probs_norm = probs./sum(probs);
            cumprobs = cumsum(probs_norm);
            k = find(cumprobs >= rand, 1, 'first');
            n_unsat(m == j & layer_index == i) =  10.^((resistivities(k+1) - resistivities(k))*rand + resistivities(k));
        end


        % Check if there is an unsaturated resistivity and apply above the water table
        if o ~= z_vec(1)
            method2 = info.Resistivity.format2(j);

            if method2 == 1
                % Due to the definition of log-gaussian resistivity uncertainty
                res_unc = log10(info.Resistivity.res4{j}) / 3;
                n_unsat(m == j & layer_index == i) =  10.^(log10(info.Resistivity.res1{j}) + res_unc * randn);

            elseif method2 == 2
                n_unsat(m == j & layer_index == i) =  (info.Resistivity.res4{j} - info.Resistivity.res3{j}) * rand + info.Resistivity.res3{j};

            elseif method2 == 3
                resistivities = info.Resistivity.res3{j};
                cumprobs = info.Resistivity.res4{j};
                k = find(cumprobs >= rand, 1, 'first');
                n_unsat(m == j & layer_index == i) =  10.^((resistivities(k+1) - resistivities(k))*rand + resistivities(k));

            end
        end

    end
end


% Calculate the mean resistivity in the dz interval containing the water table
if o ~= 0
    n(z_vec < o) = n_unsat(z_vec < o);
    diffs = z_vec-o;
    idx = find(diffs(1:end-1).*diffs(2:end) < 0);


    % Weighted mean the interval with the water table
    if ~isempty(idx)
        n(idx+1) = (n_unsat(idx+1).*abs(diffs(idx)) + n(idx+1).*diffs(idx+1)) / (abs(diffs(idx)) + diffs(idx+1));
    end
end